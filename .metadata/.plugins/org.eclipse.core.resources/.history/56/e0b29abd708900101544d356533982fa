package core;

import java.util.HashSet;
import java.util.Iterator;
import java.util.Set;

public class P028_Set {
	public static void main(String[] args) {
		Set set = new HashSet();
		set.add(123);
		set.add('a');
		set.add("java");
		set.add(345.45);
		set.add(true);
		set.add(123);
		System.out.println(set);
		
		Iterator itr = set.iterator();
		while(itr.hasNext()) {
			System.out.println(itr.next());
		}
	}
}
