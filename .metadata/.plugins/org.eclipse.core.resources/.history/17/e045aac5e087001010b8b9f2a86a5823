package core;

class Table {
	public void printTable(int num) {
		for (int i = 1; i <= 10; i++) {
			System.out.println(i * num);
		}
	}
}

class MyTable extends Thread {
	Table t;
	Thread thread = new Thread();
	MyTable(Table t) {
		this.t = t;
		thread.start();
	}

	public void run() {
		t.printTable(5);
		try {
			Thread.sleep(2000);
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
}

class MyNewTable extends Thread {
	Table t;
	Thread thread  = new Thread();
	MyNewTable(Table t) {
		this.t = t;
		thread.start();
	}

	public void run() {
		t.printTable(10);
		try {
			Thread.sleep(2000);
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
}

public class P027_Synchronization {
	public static void main(String[] args) {

		Table t = new Table();

		MyTable t1 = new MyTable(t);
		MyNewTable t2 = new MyNewTable(t);
		

	}
}
